#!/usr/bin/env python3
"""Brings a host into focus.

iterm2 targets are session UUIDs; pinned-app targets are application names.
"""

import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

# iTerm2 session ids are UUIDs: 8-4-4-4-12 hex, case-insensitive. The target
# is interpolated into an AppleScript string literal below, so anything not
# matching this shape is rejected before osascript is ever invoked.
# \Z (not $) anchors the end exactly -- $ matches before a trailing newline,
# which would otherwise let "<valid-uuid>\n" slip past the guard.
UUID_RE = re.compile(
    r"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\Z"
)

# Bounded with a short timeout: this runs synchronously from a physical
# Stream Deck key press. Focusing is near-instant when it works at all --
# a wedged iTerm2 or a pending Automation-permission dialog must not hang
# the key. subprocess.TimeoutExpired subclasses SubprocessError, not
# OSError, so it is caught explicitly below rather than folded into a
# broad `except Exception`.
FOCUS_TIMEOUT_SECS = 5

# Top-level `session id "..."` addressing errors with -1728, so walk the tree.
ITERM_SCRIPT = '''
tell application "iTerm2"
  set found to false
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        if (id of s) is "{uuid}" then
          select w
          select t
          select s
          set found to true
        end if
      end repeat
    end repeat
  end repeat
  if found then activate
  if not found then error "no such session" number 1
end tell
'''


def main(argv):
    if len(argv) < 3:
        return 1
    host, target = argv[1], argv[2]

    if host == "pinned-app":
        try:
            proc = subprocess.run(["open", "-a", target],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=FOCUS_TIMEOUT_SECS)
        except subprocess.TimeoutExpired:
            fleetlib.log("focus: open -a {} timed out".format(target))
            return 1
        return 0 if proc.returncode == 0 else 1

    if host == "iterm2":
        if not target:
            return 1
        if not UUID_RE.match(target):
            fleetlib.log("focus: rejected malformed iterm target {!r}".format(target))
            return 1
        try:
            proc = subprocess.run(["osascript", "-e", ITERM_SCRIPT.format(uuid=target)],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=FOCUS_TIMEOUT_SECS)
        except subprocess.TimeoutExpired:
            fleetlib.log("focus: osascript for iterm session {} timed out".format(target))
            return 1
        if proc.returncode != 0:
            fleetlib.log("focus: iterm session {} not found".format(target))
            return 1
        return 0

    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
