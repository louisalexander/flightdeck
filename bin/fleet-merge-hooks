#!/usr/bin/env python3
"""Merges hooks/settings.snippet.json into a Claude settings.json in place.

Usage: fleet-merge-hooks <target> <snippet> <backup>

<target>  the live settings.json to update (already exists).
<snippet> the hooks snippet with __PYTHON__/__REPO__ already substituted.
<backup>  a copy of <target> taken and JSON-validated by the caller
          BEFORE this script ran -- used both as the merge base and as
          the restore source if anything at all goes wrong.

Every top-level key OTHER than "hooks" is a plain recursive dict-merge
(pre-existing values win unless the snippet supplies a nested dict to
merge into them -- this snippet never touches non-hooks keys, so in
practice every other key is untouched).

"hooks" needs different treatment: hooks.<Event> is a JSON ARRAY, and a
naive dict-merge replaces arrays wholesale. If any other plugin had
already registered a hook on one of the seven events flightdeck manages,
a wholesale replace would silently delete it. So per event:
  - every existing entry that is NOT ours survives untouched
  - any existing entry that IS ours is dropped, so re-running replaces
    our own entry instead of duplicating it
  - our new entry is appended
The array is never replaced wholesale.

"Ours" is identified by a command containing one of OWN_MARKERS --
"/bin/fleet-emit" (six events) or "/bin/fleet-decide" (PermissionRequest)
-- NOT by the current invocation's full repo path. This is deliberate:
if the checkout moves (a second machine, or the folder gets relocated,
as already happened once in this project), a path-anchored marker would
stop matching the old entry, which would then be treated as a foreign
hook and preserved forever while a new one piles up beside it on every
run. Matching on the path-independent suffix means a relocated checkout
cleanly REPLACES its own old entry instead of accumulating duplicates.
Two markers rather than one: PermissionRequest's command names
fleet-decide, not fleet-emit, so a single "/bin/fleet-emit" marker would
never recognise that entry as ours on a second run -- is_ours() would
return False for it every time, and the per-event "drop ours, append
new" rule would degrade into "keep everything, append new", duplicating
the PermissionRequest hook (and therefore the fleet-decide process) once
per install run, forever.
(bin/fleet-doctor separately -- and correctly -- checks that the
surviving entry points at ITS OWN checkout; that stricter check is
what a stale-pointer report should look like, and this looser merge
marker is what makes install.sh able to fix what doctor reports.)

The entire read/merge/write/verify sequence runs inside one try/except:
ANY exception at any point -- a bad backup, a merge bug, a disk-full
mid-write, an interrupted write, a failed verification -- restores
<target> from <backup> before this script exits 1. The write itself
goes through fleetlib.write_json_atomic (temp file in the same
directory, then os.replace()), the same discipline used everywhere
else in this project, so a torn/partial <target> is not possible from
the write step alone; the surrounding try/except is the second,
independent line of defense for every OTHER way this could fail. The
restore path itself is also a temp-file-plus-os.replace() write of the
backup's raw bytes (never a JSON re-serialization), so the restored
file is byte-identical to the backup and the restore step is itself
non-torn.

FLEET_MERGE_HOOKS_FORCE_WRITE_FAILURE is a test-only fault-injection
hook: when set, it raises immediately before the atomic write so tests
can exercise the restore path deterministically, independent of actual
disk/OS failures. It must never be set outside a test.
"""
import json
import os
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

HOOK_EVENTS = ("SessionStart", "UserPromptSubmit", "Notification", "Stop", "SessionEnd",
               "PreToolUse", "PermissionRequest")
# Two markers, not one: fleet-emit covers the six event hooks, fleet-decide
# covers PermissionRequest. See the module docstring for the duplication
# bug a single "/bin/fleet-emit" marker would silently reintroduce.
OWN_MARKERS = ("/bin/fleet-emit", "/bin/fleet-decide")


class VerificationError(Exception):
    pass


def is_ours(entry):
    if not isinstance(entry, dict):
        return False
    for h in entry.get("hooks", []) or []:
        command = h.get("command") or "" if isinstance(h, dict) else ""
        if any(marker in command for marker in OWN_MARKERS):
            return True
    return False


def merge_hooks(existing, incoming):
    """Per-event merge of hook arrays. Never replaces an array wholesale."""
    out = dict(existing) if isinstance(existing, dict) else {}
    for event, new_entries in incoming.items():
        current = out.get(event, [])
        if not isinstance(current, list):
            current = []
        kept = [e for e in current if not is_ours(e)]
        out[event] = kept + list(new_entries)
    return out


def merge_top(a, b):
    out = dict(a)
    for k, v in b.items():
        if k == "hooks" and isinstance(v, dict):
            out[k] = merge_hooks(out.get(k, {}), v)
        elif k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k] = merge_top(out[k], v)
        else:
            out[k] = v
    return out


def restore(target, backup_path):
    """Atomically overwrites <target> with the exact bytes of <backup>.

    Raw byte copy, never a JSON re-serialization -- the restored file
    must be byte-identical to the backup, whatever its formatting.
    """
    directory = os.path.dirname(os.path.abspath(target)) or "."
    with open(backup_path, "rb") as bf:
        content = bf.read()
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".{}.".format(os.path.basename(target)))
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(content)
        os.replace(tmp, target)
    except Exception:
        try:
            os.unlink(tmp)
        except Exception:
            pass
        raise


def main():
    if len(sys.argv) != 4:
        print("usage: fleet-merge-hooks <target> <snippet> <backup>", file=sys.stderr)
        return 1

    target, snippet_path, backup_path = sys.argv[1:4]
    original = None

    try:
        with open(backup_path, encoding="utf-8") as f:
            original = json.load(f)
        with open(snippet_path, encoding="utf-8") as f:
            snippet = json.load(f)

        original_hooks = original.get("hooks") if isinstance(original.get("hooks"), dict) else {}
        third_party_before = {
            event: [e for e in (original_hooks.get(event) or []) if not is_ours(e)]
            for event in HOOK_EVENTS
        }

        merged = merge_top(original, snippet)

        if os.environ.get("FLEET_MERGE_HOOKS_FORCE_WRITE_FAILURE"):
            # Test-only fault injection -- see module docstring.
            raise RuntimeError("FLEET_MERGE_HOOKS_FORCE_WRITE_FAILURE forced failure")

        fleetlib.write_json_atomic(target, merged, indent=2)

        with open(target, encoding="utf-8") as f:
            written = json.load(f)

        for key, value in original.items():
            if key == "hooks":
                continue
            if key not in written or written[key] != value:
                raise VerificationError(
                    "pre-existing key {!r} changed or missing after merge".format(key))

        written_hooks = written.get("hooks") if isinstance(written.get("hooks"), dict) else {}
        for event, before in third_party_before.items():
            after = [e for e in (written_hooks.get(event) or []) if not is_ours(e)]
            if after != before:
                raise VerificationError(
                    "non-flightdeck hook entries on {!r} were disturbed".format(event))

        for event in HOOK_EVENTS:
            ours_after = [e for e in (written_hooks.get(event) or []) if is_ours(e)]
            if len(ours_after) != 1:
                raise VerificationError(
                    "expected exactly one flightdeck entry on {!r}, found {}".format(
                        event, len(ours_after)))

    except Exception as err:
        print("ERROR: {}".format(err), file=sys.stderr)
        try:
            restore(target, backup_path)
            print("restored {} from {}".format(target, backup_path), file=sys.stderr)
        except Exception as restore_err:
            print("ERROR: restore itself failed: {}".format(restore_err), file=sys.stderr)
        return 1

    kept_keys = len(original) - (1 if "hooks" in original else 0)
    print("verified: {} pre-existing top-level key(s) intact; "
          "third-party hook entries preserved on all {} events; "
          "flightdeck hook present exactly once per event".format(kept_keys, len(HOOK_EVENTS)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
