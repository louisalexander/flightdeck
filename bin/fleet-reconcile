#!/usr/bin/env python3
"""Turns session files into a sticky slot map at $FLEET_HOME/slots.json.

Stickiness is the point: a session claims the lowest free slot on first
sight and holds it until it dies. When it dies the slot goes empty and
NOTHING ELSE MOVES. Keys that shift under your thumb destroy the whole
value of the row.
"""

import json
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

RENDERER_TIMEOUT_SECS = 1   # SessionEnd hooks SHARE a 1.5s budget; see below


def load_live_sessions():
    """Every parseable session file, oldest first for stable assignment."""
    sessions = []
    directory = fleetlib.sessions_dir()
    if not directory.is_dir():
        return sessions
    for path in sorted(directory.glob("*.json")):
        data = fleetlib.read_json(path)
        if isinstance(data, dict) and data.get("session_id"):
            sessions.append(data)
    sessions.sort(key=lambda s: (s.get("ts", 0), s.get("session_id", "")))
    return sessions


def previous_assignment():
    """slot index (as int) -> session_id, from the last written slots.json."""
    previous = fleetlib.read_json(fleetlib.slots_path(), {}) or {}
    result = {}
    for slot in previous.get("slots", []):
        if slot.get("session_id"):
            result[slot["index"]] = slot["session_id"]
    return result


def empty_slot(index):
    return {"index": index, "state": "empty", "label_top": "", "label_bottom": "",
            "session_id": "", "host": "", "iterm_session": "", "cwd": "", "app": "",
            "focused": False, "permission_mode": ""}


def pinned_slot(index, pin):
    return {"index": index, "state": "idle",
            "label_top": pin.get("label_top", ""),
            "label_bottom": pin.get("label_bottom", ""),
            "session_id": "", "host": pin.get("host", "pinned-app"),
            "iterm_session": "", "cwd": "", "app": pin.get("app", ""),
            "focused": False, "permission_mode": ""}


def session_slot(index, session, max_chars, prefixes, focus_id="", titles=None):
    # Precedence: the live iTerm2 task title, then the session record's own
    # title, then the branch. The middle rung looks dead -- fleet-emit
    # hardcodes "title": "" -- but it is the documented shape of a session
    # record and tests/reconcile.bats asserts it beats the branch, so it
    # stays as the seam a non-iTerm host would write.
    raw = (titles or {}).get(session.get("iterm_session", ""), "")
    title = fleetlib.clean_title(raw) or (session.get("title") or "").strip()
    bottom = title if title else (session.get("branch") or "")
    # Row 1's mode annunciation: whatever fleet-emit last recorded for this
    # session, or "" (unknown) if it never has -- see fleet-emit's own
    # comment on why absence must never be read as "default".
    mode = session.get("permission_mode")
    return {"index": index,
            "state": session.get("state", "idle"),
            "label_top": fleetlib.shorten(session.get("repo", ""), max_chars, prefixes),
            "label_bottom": fleetlib.shorten(bottom, max_chars, prefixes),
            "session_id": session["session_id"],
            "host": session.get("host", "unknown"),
            "iterm_session": session.get("iterm_session", ""),
            "cwd": session.get("cwd", ""),
            "app": "",
            "focused": bool(focus_id) and session.get("session_id") == focus_id,
            "permission_mode": mode if isinstance(mode, str) else ""}


def run_renderers(config, live):
    """Pipes the fleet snapshot to each configured external renderer.

    The snapshot is piped rather than letting renderers read ~/.fleet
    themselves: that makes the seam an explicit contract, and lets a renderer
    live in another repo without importing fleetlib.

    Renderers are invoked directly as executables, so they may be written in
    any language. A Python renderer must be 3.9-compatible -- this path is
    reachable from launchd via fleet-reap.

    Nothing a renderer does may break reconcile or the Stream Deck: a missing,
    crashing, hanging, or chatty renderer is logged and stepped over.

    The timeout is deliberately kept under the SessionEnd hook budget: the
    chain SessionEnd -> fleet-emit -> fleet-reconcile -> renderer runs on a
    path where all SessionEnd hooks together share 1.5 seconds, so a renderer
    that cannot answer within one second IS the pathological case this
    timeout exists to step over. The renderer this seam was built for
    dispatches its real work via a detached subprocess.Popen and returns in
    milliseconds; a renderer that needs longer than that should do its slow
    work detached rather than asking this seam for more time.
    """
    renderers = config.get("renderers") or []
    if not renderers:
        return

    snapshot = json.dumps({
        "ts": int(time.time()),
        "sessions": [{
            "session_id": s.get("session_id", ""),
            "state": s.get("state", "idle"),
            "repo": s.get("repo", ""),
            "branch": s.get("branch", ""),
            "cwd": s.get("cwd", ""),
        } for s in live],
        "states": config.get("states", {}),
    }, separators=(",", ":")).encode("utf-8")

    for command in renderers:
        try:
            subprocess.run([command], input=snapshot,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=RENDERER_TIMEOUT_SECS)
        except Exception as err:
            fleetlib.log("reconcile: renderer {} failed: {}".format(command, err))


def rule_label(suggestion):
    """Claude Code's suggested rule as one line, e.g. `Bash(git push:*)`.

    This is what REMEMBER's armed face shows next to the repository name,
    and it is the whole content of the mitigation for the worktree trap:
    the operator is one press from a rule that widens every worktree of
    that repository, so the confirmation has to say WHICH rule. The face
    is specced in docs (README, the Rows 3-4 design) and was previously
    undeliverable because this field never reached slots.json at all.

    Formatted here rather than in the plugin, which stays a renderer and
    holds no knowledge of what a permission suggestion looks like. Only
    the rules are rendered -- never `destination` or `behavior`, which are
    the same on every suggestion Claude Code offers and would spend the
    key's two legible lines on nothing.

    Returns "" for anything unrecognised: REMEMBER refuses without a
    suggestion anyway, and an armed face that cannot name the rule must
    say nothing rather than invent something.
    """
    if not isinstance(suggestion, dict):
        return ""
    rules = suggestion.get("rules")
    if not isinstance(rules, list):
        return ""
    rendered = []
    for rule in rules:
        if not isinstance(rule, dict):
            continue
        tool = rule.get("toolName")
        content = rule.get("ruleContent")
        if not isinstance(tool, str) or not tool:
            continue
        if isinstance(content, str) and content:
            rendered.append("{}({})".format(tool, content))
        else:
            rendered.append(tool)
    if not rendered:
        return ""
    # More than one rule in a single suggestion has not been observed, but
    # the field is a list: name the first and COUNT the rest rather than
    # concatenating, so the key can never imply the press is narrower than
    # it is.
    if len(rendered) > 1:
        return "{} +{}".format(rendered[0], len(rendered) - 1)
    return rendered[0]


def main():
    config = fleetlib.load_config()
    count = config.get("slots", {}).get("count", 8)
    pins = config.get("pins", {}) or {}
    labels = config.get("labels", {})
    max_chars = labels.get("maxChars", 11)
    prefixes = labels.get("stripPrefixes", fleetlib.DEFAULT_PREFIXES)

    live = load_live_sessions()
    by_id = {s["session_id"]: s for s in live}
    previous = previous_assignment()

    # A selection outliving its session would leave a border on a key that
    # has been reassigned to someone else -- worse than no border at all.
    focus_id = fleetlib.read_focus()
    if focus_id and focus_id not in by_id:
        fleetlib.clear_focus()
        focus_id = ""

    # Pass 1: every index is a pin, a retained session, or free.
    held = {}
    free = []
    for index in range(count):
        pin = pins.get(str(index))
        if pin:
            continue
        keeper = previous.get(index)
        if keeper and keeper in by_id:
            held[index] = keeper
        else:
            free.append(index)

    # Pass 2: sessions with no slot fill the free indices, lowest first.
    assigned = set(held.values())
    pending = [s["session_id"] for s in live if s["session_id"] not in assigned]
    for index in free:
        if not pending:
            break
        held[index] = pending.pop(0)

    # One osascript for the whole fleet, not one per session. Empty on any
    # failure, which falls every key back to its branch label.
    titles = fleetlib.iterm_session_titles()

    # Pass 3: render.
    slots = []
    for index in range(count):
        pin = pins.get(str(index))
        if pin:
            slots.append(pinned_slot(index, pin))
        elif index in held:
            slots.append(session_slot(index, by_id[held[index]], max_chars,
                                      prefixes, focus_id, titles))
        else:
            slots.append(empty_slot(index))

    # One file, one watch. The plugin already watches slots.json, so
    # everything it must render travels there rather than teaching it a
    # second source. input_summary is deliberately excluded below: no key
    # ever renders tool input, and putting it here is exactly how it would
    # leak onto a key later -- the pending record already carries it for
    # the log and terminal only.
    halted = fleetlib.halt_path().exists()

    verdict = None
    target = fleetlib.resolve_target()
    if target:
        record = fleetlib.read_json(fleetlib.pending_path(target))
        if isinstance(record, dict):
            # DETAIL's identity line must read the same as the Row 1 key for
            # the same agent -- that is the whole point of "show me the one I
            # am about to act on". Row 1's label comes from the SESSION file's
            # repo (bin/fleet-emit, --show-toplevel), which for a worktree
            # session is the worktree's own name, while the pending record's
            # repo is now deliberately the CANONICAL repository for REMEMBER's
            # armed face. Those two answers differ for exactly the sessions
            # this fleet runs, so read the identity from the session and fall
            # back to the record only when there is no session file.
            session = by_id.get(target) or {}
            agent = session.get("repo") or record.get("repo") or ""
            verdict = {
                "session_id": target,
                # The agent's identity, shortened by the same rule Row 1 uses.
                "agent": fleetlib.shorten(agent, 11),
                "tool": record.get("tool") or "",
                "tier": record.get("tier") or "normal",
                "repeats": record.get("repeats") if isinstance(record.get("repeats"), int) else 1,
                # The two fields REMEMBER's armed face needs. `repo` is the
                # CANONICAL repository (bin/fleet-decide derives it from
                # --git-common-dir, never the worktree), carried unshortened
                # so the renderer -- which knows the font and the key width --
                # decides how to fit it; `agent` above stays shortened because
                # DETAIL's classification line has always been drawn that way.
                # The agent is deliberately NOT on the armed face: it is the
                # one scope this press is not limited to.
                "repo": record.get("repo") or "",
                "rule": rule_label(record.get("suggestion")),
            }

    fleetlib.write_json_atomic(fleetlib.slots_path(), {
        "ts": int(time.time()), "overflow": len(pending), "slots": slots,
        "halted": halted, "verdict": verdict,
    })
    if pending:
        fleetlib.log("reconcile: {} session(s) unslotted (overflow)".format(len(pending)))

    run_renderers(config, live)


if __name__ == "__main__":
    try:
        main()
    except Exception as err:            # noqa: BLE001
        fleetlib.log("reconcile: unhandled {!r}".format(err))
    sys.exit(0)
