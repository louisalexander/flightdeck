#!/usr/bin/env python3
"""Claude Code hook entrypoint. Records agent state.

MUST ALWAYS EXIT 0. A bug in this file must never break a real agent.
"""

import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

EVENT_STATES = {
    "SessionStart": "idle",
    "UserPromptSubmit": "working",
    "Notification": "blocked",
    "Stop": "done",
    "SessionEnd": "__end__",
}

# These already prove the agent is no longer waiting on the operator (a
# fresh prompt, a completed turn, or the session tearing down entirely),
# so each one also clears any blocked-marker left by a prior Notification
# -- belt and braces alongside the Resumed guard hook itself, so a marker
# can never be orphaned even if that hook never fires for some reason. A
# stale marker would make the PreToolUse guard pay for a python process
# on every single tool call forever, which is the one way this fix could
# become the problem it was meant to solve.
MARKER_CLEARING_EVENTS = ("UserPromptSubmit", "Stop", "SessionEnd")

# Claude Code fires Notification for two unrelated situations and hands us a
# notification_type to tell them apart. Amber is a request for input, so only
# the types where the agent has stopped and cannot continue until the operator
# decides something may paint one: permission_prompt, worker_permission_prompt,
# agent_needs_input, elicitation_dialog, elicitation_url_dialog.
#
# Everything below is informational -- chiefly idle_prompt, the ~60s nudge
# after a finished turn. Mapping those to blocked is what made `done` decay
# into `blocked` after a minute of not looking at the deck, collapsing the
# distinction between "finished" and "stuck".
#
# This is the ignore-list rather than the block-list on purpose: a type Claude
# Code adds later is then treated as blocking until someone classifies it. That
# asymmetry is the safety argument -- an unexpected amber is visible and the
# Resumed guard clears it on the next tool call, but an unexpected green on a
# stuck agent is invisible and stays wrong until a human happens to notice.
IGNORED_NOTIFICATION_TYPES = frozenset((
    "idle_prompt",
    "agent_completed",
    "auth_success",
    "push_notification",
    "computer_use_enter",
    "computer_use_exit",
))


PS_TIMEOUT_SECS = 2
RECONCILE_TIMEOUT_SECS = 10

# A Stop that carries a queued verb is not the end of the turn: blocking it
# hands the verb to the agent, which then continues. The slot must therefore
# read `working`, not `done` -- painting it green for the instant before the
# agent picks up would be a lie the operator could actually catch.
DRAIN_STATE = "working"


def _ps_field(pid, field):
    """Runs `ps -o <field>= -p <pid>` and returns the stripped single-field value.

    Kept to one field per call deliberately: macOS's `comm` is a full binary
    path and can contain spaces (e.g. "/Applications/Private Internet
    Access.app/Contents/MacOS/pia-daemon"). Combining `comm` and `ppid` into
    one `ps` call and whitespace-splitting the result -- as a first draft of
    this function did -- silently truncates `comm` at the first space and
    misparses the pid. Two single-field calls sidestep both problems: no
    whitespace-splitting is needed since each field is read whole.

    Bounded with a short timeout: this runs synchronously inside a live
    agent session, and `ps` answers immediately or is wedged -- there is no
    legitimate slow case to accommodate. subprocess.run raises
    TimeoutExpired (a subclass of SubprocessError, itself a subclass of
    Exception, so it is caught below) rather than hanging forever.
    """
    try:
        proc = subprocess.run(
            ["ps", "-o", "{}=".format(field), "-p", str(pid)],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=PS_TIMEOUT_SECS,
        )
        return proc.stdout.decode("utf-8", "replace").strip()
    except Exception as err:
        fleetlib.log("emit: ps -o {} -p {} failed: {}".format(field, pid, err))
        return ""


def find_agent_pid():
    """Walk up the process tree to the agent this hook was spawned from."""
    pid = os.getppid()
    for _ in range(6):
        if pid <= 1:
            break
        comm = _ps_field(pid, "comm")
        if not comm:
            break
        ppid_out = _ps_field(pid, "ppid")
        if not ppid_out:
            break
        base = comm.rsplit("/", 1)[-1]
        if base in ("claude", "node"):
            return pid
        try:
            pid = int(ppid_out)
        except Exception:
            break
    return 0


def run(event):
    is_resumed = event == "Resumed"
    state = EVENT_STATES.get(event)
    if state is None and not is_resumed:
        fleetlib.log("emit: ignoring unknown event {!r}".format(event))
        return

    try:
        payload = json.loads(sys.stdin.read())
        if not isinstance(payload, dict):
            raise ValueError("payload is not an object")
    except Exception:
        fleetlib.log("emit: unparseable payload for {}".format(event))
        return

    session_id = payload.get("session_id") or os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
    if not session_id:
        fleetlib.log("emit: no session id for {}".format(event))
        return

    cwd = payload.get("cwd") or os.getcwd()

    # iTerm exports w<win>t<tab>p<pane>:<uuid>; only the uuid is addressable.
    iterm = os.environ.get("ITERM_SESSION_ID", "")
    iterm_uuid = iterm.split(":", 1)[1] if ":" in iterm else ""
    host = "iterm2" if iterm_uuid else "unknown"

    repo = branch = ""
    code, top = fleetlib.git(["rev-parse", "--show-toplevel"], cwd)
    if code == 0 and top:
        repo = Path(top).name
        _, branch = fleetlib.git(["rev-parse", "--abbrev-ref", "HEAD"], cwd)

    now = int(time.time())

    # A Notification only means "blocked" for the types that actually await an
    # operator decision. An absent or unrecognised type keeps the old
    # unconditional behaviour on purpose: a false amber is visible and clears
    # itself on the next tool call via the Resumed guard, whereas treating a
    # real block as informational would leave a stuck agent showing green --
    # the one failure a fleet deck must not have.
    notification_type = ""
    ignored_notification = False
    if event == "Notification":
        raw = payload.get("notification_type")
        notification_type = raw if isinstance(raw, str) else ""
        ignored_notification = notification_type in IGNORED_NOTIFICATION_TYPES

    # Stop fires when the assistant turn ends, which is not the same thing as
    # the agent awaiting the operator. A turn that ends with a backgrounded
    # subagent, shell, workflow or monitor still in flight wakes itself back up
    # with no operator action at all, so the session is still working. Painting
    # it green would claim a completion that has not happened and invite the
    # operator to hand an instruction to a busy agent -- the same failure the
    # idle_prompt fix above exists to prevent, arriving by a different route.
    #
    # Claude Code hands us the distinction directly: background_tasks is
    # documented as letting hooks "distinguish 'session is done' from 'session
    # is paused waiting for background work to wake it'".
    #
    # Absence is read as "no information", not as "nothing in flight" -- the
    # field is optional and older Claude Code omits it entirely, and there the
    # historical done mapping is the best guess available. Only a non-empty
    # list holds the key blue; anything else falls through to done.
    background_tasks = payload.get("background_tasks")
    in_flight = len(background_tasks) if isinstance(background_tasks, list) else 0
    if event == "Stop" and in_flight:
        state = "working"

    # Journal spine first, so removals are recorded too.
    record = {
        "event": event, "session_id": session_id, "repo": repo,
        "branch": branch, "cwd": cwd, "ts": now,
    }
    if notification_type:
        record["notification_type"] = notification_type
    if in_flight:
        record["background_tasks"] = in_flight
    try:
        fleetlib.append_jsonl(fleetlib.events_path(), record)
    except Exception as err:
        fleetlib.log("emit: could not append event: {}".format(err))

    # Journalled above so the trail stays complete, but the slot keeps whatever
    # state it already had: no session write, no marker, no reconcile.
    if ignored_notification:
        return

    target = fleetlib.sessions_dir() / "{}.json".format(session_id)
    if is_resumed:
        # Only a genuine blocked -> working transition is real. A missing
        # session (already reaped or ended) or one that is no longer
        # blocked (a Stop or UserPromptSubmit already cleared it first)
        # must never be resurrected or overwritten -- this is a no-op.
        existing = fleetlib.read_json(target)
        if isinstance(existing, dict) and existing.get("state") == "blocked":
            existing["state"] = "working"
            existing["ts"] = now
            fleetlib.write_json_atomic(target, existing)
        fleetlib.clear_blocked_marker(session_id)
    elif state == "__end__":
        try:
            target.unlink()
        except Exception:
            pass
        # A resumed Claude Code session keeps its session id, so a queue
        # entry staged before SessionEnd would otherwise survive to be
        # delivered by the first Stop after resume -- a verb pressed
        # against a session that has since ended firing into whatever
        # session comes back under the same id. The spec requires this.
        try:
            fleetlib.queue_path(session_id).unlink()
        except Exception:
            pass
        fleetlib.clear_blocked_marker(session_id)
    else:
        drained = None
        # Deliberately NOT gated on stop_hook_active. The old gate skipped
        # the drain whenever a Stop was itself the result of a previous
        # block continuing -- which strands a verb queued during that
        # continuation forever: press TEST while working, Stop blocks,
        # the agent continues into TEST, a second verb gets pressed during
        # that continuation, and the Stop ending IT carries
        # stop_hook_active -- so the gate skipped it, the session went
        # idle, and no further Stop was ever coming to retry it. The
        # no-re-fire guarantee this gate was defending does not need it:
        # drain-before-block (claim, THEN emit the block) is what actually
        # prevents a loop, because the entry is gone before the block is
        # returned -- an empty queue on the very next Stop, re-fired or
        # not, yields claim_queue() is None and no block. stop_hook_active
        # buys nothing here and costs a permanent silent stranding.
        if event == "Stop":
            claimed = fleetlib.claim_queue(session_id)
            if isinstance(claimed, dict) and isinstance(claimed.get("prompt"), str) \
                    and claimed["prompt"].strip():
                drained = claimed

        fleetlib.write_json_atomic(target, {
            "session_id": session_id,
            "state": DRAIN_STATE if drained else state,
            "repo": repo, "branch": branch, "title": "", "cwd": cwd, "host": host,
            "iterm_session": iterm_uuid, "pid": find_agent_pid(), "ts": now,
        })
        if state == "blocked":
            fleetlib.create_blocked_marker(session_id)
        elif event in MARKER_CLEARING_EVENTS:
            fleetlib.clear_blocked_marker(session_id)

        if drained:
            # The only path on which this hook prints anything. Claimed and
            # removed above, so a crash between here and the write costs one
            # verb rather than looping forever.
            sys.stdout.write(json.dumps({
                "decision": "block", "reason": drained["prompt"],
            }))

    if os.environ.get("FLEET_SKIP_RECONCILE") != "1":
        try:
            subprocess.run([sys.executable, str(Path(__file__).resolve().parent / "fleet-reconcile")],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=RECONCILE_TIMEOUT_SECS)
        except Exception as err:
            fleetlib.log("emit: fleet-reconcile call failed: {}".format(err))


if __name__ == "__main__":
    try:
        run(sys.argv[1] if len(sys.argv) > 1 else "")
    except Exception as err:            # noqa: BLE001 -- the exit-0 guarantee
        fleetlib.log("emit: unhandled {!r}".format(err))
    sys.exit(0)
