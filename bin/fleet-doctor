#!/usr/bin/env python3
"""Verifies every moving part. Exits 0 only if all checks pass."""

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

GREEN, RED, RESET = "\033[32m", "\033[31m", "\033[0m"
failed = False


def ok(message):
    print("  {}ok{}    {}".format(GREEN, RESET, message))


def bad(message, hint=""):
    global failed
    failed = True
    print("  {}FAIL{}  {}".format(RED, RESET, message))
    if hint:
        print("        {}".format(hint))


def have(name):
    """`command -v` is a shell builtin and is not executable via subprocess."""
    return subprocess.run(["/usr/bin/which", name], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def main():
    print("flightdeck doctor\n")

    print("  python: {} ({})".format(sys.executable, sys.version.split()[0]))
    if sys.version_info < (3, 9):
        bad("python is older than 3.9")
    else:
        ok("python version supported")

    pinned = fleetlib.fleet_home() / "interpreter"
    if pinned.is_file():
        path = pinned.read_text().strip()
        if Path(path).exists():
            ok("interpreter pinned to {}".format(path))
        else:
            bad("pinned interpreter {} does not exist".format(path), "re-run ./install.sh")
    else:
        bad("no pinned interpreter", "re-run ./install.sh")

    for tool in ("git", "osascript", "node"):
        ok("{} present".format(tool)) if have(tool) else bad("{} missing".format(tool))

    home = fleetlib.fleet_home()
    try:
        fleetlib.sessions_dir().mkdir(parents=True, exist_ok=True)
        probe = home / ".probe"
        probe.write_text("x")
        probe.unlink()
        ok("{} writable".format(home))
    except Exception as err:
        bad("{} not writable: {}".format(home, err))

    HOOK_EVENTS = ("SessionStart", "UserPromptSubmit", "Notification", "Stop", "SessionEnd",
                   "PreToolUse")
    settings = Path.home() / ".claude" / "settings.json"
    if settings.is_file():
        data = fleetlib.read_json(settings, {}) or {}
        hooks = data.get("hooks") or {}
        repo = fleetlib.repo_root()
        marker = "{}/bin/fleet-emit".format(repo)
        matching, stale = 0, 0
        for event in HOOK_EVENTS:
            blob = json.dumps(hooks.get(event) or [])
            if marker in blob:
                matching += 1
            elif "fleet-emit" in blob:
                stale += 1
        if matching == 6:
            ok("all 6 hooks registered")
        elif stale:
            bad("{} hook(s) reference fleet-emit but not this checkout ({})".format(
                    stale, repo),
                "stale install pointing at a different checkout; re-run ./install.sh from this repo")
        else:
            bad("expected 6 fleet-emit hooks pointing at {}, found {}".format(repo, matching),
                "re-run ./install.sh")

        # This check looked only at fleet-emit hooks until now, so a stale or
        # missing PermissionRequest entry -- the one that actually runs
        # fleet-decide -- went unnoticed after a repo relocation: Row 3 would
        # be silently dead while every other check stayed green. Same
        # path-anchored style as the fleet-emit check above, on the one
        # marker fleet-merge-hooks itself treats as "ours" for this event
        # (see OWN_MARKERS in bin/fleet-merge-hooks).
        decide_marker = "{}/bin/fleet-decide".format(repo)
        decide_blob = json.dumps(hooks.get("PermissionRequest") or [])
        if decide_marker in decide_blob:
            ok("PermissionRequest hook registered")
        elif "fleet-decide" in decide_blob:
            bad("PermissionRequest hook references fleet-decide but not this checkout ({})".format(
                    repo),
                "stale install pointing at a different checkout; re-run ./install.sh")
        else:
            bad("no PermissionRequest hook naming fleet-decide", "re-run ./install.sh")

        # The one check that stops HALT being a claim rather than a fact:
        # the PreToolUse command packs the halt clause and the Resumed guard
        # into one shell command, and it is their ORDER that decides the
        # outcome when both a latch and a blocked marker are present (see
        # tests/halt.bats B1). A future edit that reordered them would leave
        # HALT silently not winning, with nothing else here to catch it.
        #
        # Anchored on `marker` (the same fleet-emit path this checkout
        # owns), exactly like the two checks above -- not on the whole
        # PreToolUse array. A third-party PreToolUse hook containing
        # "/halt" earlier in the array could otherwise mask a genuine
        # reorder of OUR clause, and one containing "/blocked/" could fail
        # a correct install for a reason that has nothing to do with us.
        our_pretooluse = ""
        for entry in hooks.get("PreToolUse") or []:
            if not isinstance(entry, dict):
                continue
            for h in entry.get("hooks") or []:
                command = h.get("command") or "" if isinstance(h, dict) else ""
                if marker in command:
                    our_pretooluse = command
        halt_idx = our_pretooluse.find("/halt")
        blocked_idx = our_pretooluse.find("/blocked/")
        if halt_idx != -1 and blocked_idx != -1 and halt_idx < blocked_idx:
            ok("halt clause precedes the resumed guard")
        else:
            bad("halt clause missing, or not ordered before the resumed guard",
                "re-run ./install.sh")
    else:
        bad("{} not found".format(settings), "run claude once, then ./install.sh")

    # Every prompt verb now depends on config/verbs/_common.md, and a local
    # $FLEET_HOME/verbs/_common.md overrides it -- so one broken or empty
    # fragment stops all twelve Row 2 prompt keys at once, where a broken
    # verb file stops one. That is a deliberate trade (the alternative is
    # degrading silently to a prompt missing the rules that make it safe),
    # and this is the check that makes it diagnosable in one command rather
    # than mysterious at the deck. Asking fleet-verbs itself, rather than
    # re-implementing the lookup here, so the two cannot disagree.
    verbs_dir = fleetlib.repo_root() / "config" / "verbs"
    resolver = fleetlib.repo_root() / "bin" / "fleet-verbs"
    # A `_`-prefixed file is a fragment, not a verb, and `show _common` is
    # refused by design -- it is exercised by the verbs that include it.
    verb_ids = sorted(p.stem for p in verbs_dir.glob("*.md")
                      if not p.name.startswith("_"))
    broken, reasons = [], []
    for verb_id in verb_ids:
        result = subprocess.run([sys.executable, str(resolver), "show", verb_id],
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if result.returncode != 0:
            broken.append(verb_id)
            # One shared cause produces one message per verb, and printing
            # twelve copies of it buries the thing the reader needs.
            reason = result.stderr.decode("utf-8", "replace").strip() or "no output"
            if reason not in reasons:
                reasons.append(reason)
    if not verb_ids:
        bad("no verbs found in {}".format(verbs_dir))
    elif broken:
        bad("{} of {} verbs do not resolve: {}".format(
                len(broken), len(verb_ids), " ".join(broken)),
            "; ".join(reasons))
    else:
        ok("all {} shipped verbs resolve".format(len(verb_ids)))

    # A latched halt nobody remembers setting looks exactly like a broken
    # fleet: every session sits blocked or denied and there is no other
    # signal on the panel pointing at the cause.
    if fleetlib.halt_path().exists():
        bad("fleet is currently HALTED", "run bin/fleet-halt --off to resume")
    else:
        ok("fleet is not halted")

    listing = subprocess.run(["launchctl", "list"], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    if b"flightdeck.reaper" in listing.stdout:
        ok("launchd reaper loaded")
    else:
        bad("launchd reaper not loaded", "re-run ./install.sh")

    plugin = (Path.home() / "Library" / "Application Support" / "com.elgato.StreamDeck"
              / "Plugins" / "com.louisalexander.flightdeck.sdPlugin")
    if plugin.exists():
        ok("plugin installed")
    else:
        bad("plugin not installed", "re-run ./install.sh")
    if (plugin / "bin" / "plugin.js").is_file():
        ok("plugin is built")
    else:
        bad("plugin not built", "cd plugin && npm run build")

    running = subprocess.run(["pgrep", "-f", "Elgato Stream Deck"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if running.returncode == 0:
        ok("Stream Deck app running")
    else:
        bad("Stream Deck app not running")

    # The classic silent killer: automation permission denied with no dialog.
    probe = subprocess.run(
        ["osascript", "-e", 'tell application "iTerm2" to count of windows'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if probe.returncode == 0:
        ok("iTerm2 automation permitted")
    else:
        bad("iTerm2 automation DENIED or iTerm2 not running",
            "System Settings > Privacy & Security > Automation, then re-run")

    print("\n" + ("all checks passed" if not failed else "some checks failed"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
