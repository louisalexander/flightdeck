#!/usr/bin/env python3
"""Press dispatcher.

Short press focuses. Long press ARMS teardown -- it does not perform it.
A second press inside the arm window confirms. Anything else disarms.
"""

import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

HERE = Path(__file__).resolve().parent

# Bounded with a short timeout: this runs synchronously from a physical
# Stream Deck key press. Focusing should be near-instant, so 10s gives it
# real headroom without letting a wedged child hang the key indefinitely.
# fleet-kill is bounded differently: it does its own git work internally
# against a 15s-per-call fleetlib.git() timeout, potentially across several
# sequential checks (status, ignored files, upstream, rev-list) plus the
# worktree removal itself. A 10s outer bound could cut it off mid
# `git worktree remove` -- leaving the worktree gone but the session file
# never unlinked. 30s gives the child room to finish its own bounded work
# end to end rather than being killed mid-mutation by an outer race.
# subprocess.TimeoutExpired subclasses SubprocessError, not OSError, so it
# is caught explicitly rather than folded into a broad `except Exception`.
FOCUS_TIMEOUT_SECS = 10
KILL_TIMEOUT_SECS = 30


def run_bounded(cmd, timeout_secs, label):
    """Runs a subprocess with a bound; never raises, never hangs the press.

    stdout/stderr are discarded rather than inherited. If they were
    inherited and the child process were later killed on timeout, a
    grandchild it spawned (e.g. a wedged adapter shelling out further)
    could still hold the inherited pipe open, leaving any caller reading
    our output (a command substitution, the Stream Deck plugin) blocked
    long after we return -- silently defeating the timeout.
    """
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                        timeout=timeout_secs)
    except subprocess.TimeoutExpired:
        fleetlib.log("press: {} timed out after {}s: {}".format(
            label, timeout_secs, cmd))
    except OSError as err:
        fleetlib.log("press: {} failed: {!r}".format(label, cmd) + " " + repr(err))


def now():
    override = os.environ.get("FLEET_NOW")
    return int(override) if override else int(time.time())


def claim_arm():
    """Atomically claims the arm marker, if any live one exists.

    Two near-simultaneous presses on the same slot must not both fire the
    kill command. A plain read-then-unlink is racy: both processes could
    read the same live arm before either unlinks it. Instead, rename
    armed.json to a unique per-pid sibling with os.replace() -- an atomic
    operation -- and treat a successful rename as sole ownership of that
    arm. Exactly one process can win; the loser's os.replace() finds the
    source already gone and raises FileNotFoundError, and must behave as
    if no arm existed at all (fall through to focus, never fire).

    The claimed file is always removed before returning, on every path
    (arm missing, expired, or for a different index), so a crash between
    the rename and the delete is the only way a stray
    armed.claim.<pid>.json can be left on disk -- and such a stray file is
    never looked at by any later press, so it is inert.
    """
    claim_path = fleetlib.armed_path().parent / "armed.claim.{}.json".format(os.getpid())
    try:
        os.replace(str(fleetlib.armed_path()), str(claim_path))
    except OSError:
        return None                    # lost the race, or nothing to claim
    try:
        return fleetlib.read_json(claim_path)
    finally:
        try:
            claim_path.unlink()
        except Exception:
            pass


def main(argv):
    if len(argv) < 2:
        return 0
    try:
        index = int(argv[1])
    except ValueError:
        return 0                       # a plugin sends this; never trust it
    verb = argv[2] if len(argv) > 2 else "short"

    data = fleetlib.read_json(fleetlib.slots_path(), {}) or {}
    matches = [s for s in data.get("slots", []) if s.get("index") == index]
    if not matches:
        return 0
    slot = matches[0]
    if slot.get("state") == "empty":
        return 0

    focus_cmd = os.environ.get("FLEET_FOCUS_CMD") or str(HERE / "fleet-focus")
    kill_cmd = os.environ.get("FLEET_KILL_CMD") or str(HERE / "fleet-kill")

    # Atomically claim (and thereby clear) the arm marker. Any press that
    # reaches this point disarms; whether it then FIRES is decided below.
    # (A press that fails slot resolution above -- unknown index or an
    # empty slot -- returns before this point and leaves a live arm
    # untouched; that's fine, because firing is still gated on the index
    # matching, so a stale arm on a *different* slot can never fire here.)
    arm = claim_arm()

    armed_live = (isinstance(arm, dict)
                  and isinstance(arm.get("expires"), int)
                  and now() < arm["expires"])

    if armed_live and arm.get("index") == index:
        fleetlib.log("press: confirmed teardown of slot {} ({})".format(
            index, slot.get("session_id", "")))
        run_bounded([kill_cmd, slot.get("session_id", "")],
                    KILL_TIMEOUT_SECS, "fleet-kill")
        return 0

    if verb == "long":
        if not slot.get("session_id") or slot.get("host") == "pinned-app":
            return 0                   # only real agent sessions are torn down
        config = fleetlib.load_config()
        arm_ms = config.get("timings", {}).get("armMs", 3000)
        fleetlib.write_json_atomic(fleetlib.armed_path(), {
            "index": index, "expires": now() + max(1, arm_ms // 1000),
        })
        return 0

    host = slot.get("host")
    if host == "iterm2" and slot.get("iterm_session"):
        run_bounded([focus_cmd, "iterm2", slot["iterm_session"]],
                    FOCUS_TIMEOUT_SECS, "fleet-focus")
    elif host == "pinned-app" and slot.get("app"):
        run_bounded([focus_cmd, "pinned-app", slot["app"]],
                    FOCUS_TIMEOUT_SECS, "fleet-focus")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception as err:            # noqa: BLE001
        fleetlib.log("press: unhandled {!r}".format(err))
        sys.exit(0)
