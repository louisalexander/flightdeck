#!/usr/bin/env python3
"""Removes session files whose agent process is gone.

Conservative by design: pid 0 or a non-numeric pid means 'unknown', and
unknown is never reaped. A stale key is a small annoyance; a key that
vanishes while its agent is alive is a correctness failure.
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import fleetlib  # noqa: E402

# Bounded with a short timeout: fleet-reap is the launchd job firing every
# 15 seconds (see config/fleet.json timings.reaperSeconds). An unbounded
# call here is worse than most -- a single wedged fleet-reconcile would let
# invocations pile up indefinitely rather than just stalling one key press.
# subprocess.TimeoutExpired subclasses SubprocessError, not OSError, so it
# is caught explicitly rather than folded into a broad `except Exception`.
RECONCILE_TIMEOUT_SECS = 10


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True          # exists, owned by someone else
    except Exception:
        return True          # never reap on an unexpected error


def main():
    directory = fleetlib.sessions_dir()
    if not directory.is_dir():
        return

    for path in sorted(directory.glob("*.json")):
        data = fleetlib.read_json(path)
        if not isinstance(data, dict):
            continue
        pid = data.get("pid", 0)
        if not isinstance(pid, int) or pid <= 0:
            continue
        if not alive(pid):
            try:
                path.unlink()
                fleetlib.log("reap: removed {} (pid {} gone)".format(path.name, pid))
            except Exception:
                pass

    if os.environ.get("FLEET_SKIP_RECONCILE") != "1":
        cmd = [sys.executable, str(Path(__file__).resolve().parent / "fleet-reconcile")]
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=RECONCILE_TIMEOUT_SECS)
        except subprocess.TimeoutExpired:
            fleetlib.log("reap: fleet-reconcile timed out after {}s".format(
                RECONCILE_TIMEOUT_SECS))
        except OSError as err:
            fleetlib.log("reap: fleet-reconcile failed: {!r}".format(err))


if __name__ == "__main__":
    try:
        main()
    except Exception as err:            # noqa: BLE001
        fleetlib.log("reap: unhandled {!r}".format(err))
    sys.exit(0)
